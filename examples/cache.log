0x00000000 - 00000001 - .word 1  (array[0])
0x00000004 - 00000002 - .word 2  (array[1])
0x00000008 - 00000003 - .word 3  (array[2])
...
0x00000028 - 00000000 - .word 0  (result)

<addr>      - <HEXCODE>  - <mnemonic>
0x00000000 - 000002B7 - lui t0, 0x0             ; загрузка upper 20 bits адреса array в x5 (t0)
0x00000004 - 00028293 - addi t0, t0, 0          ; t0 указывает на 0x00000000 (адрес array)
0x00000008 - 00000337 - lui t1, 0x0             ; загрузка 0 в t1 (x6)
0x0000000C - 00A30313 - addi t1, t1, 10         ; t1 = 10 счетчик цикла
0x00000010 - 000003B7 - lui t2, 0x0             ; загрузка 0 в t2 (x7)
0x00000014 - 00038393 - addi t2, t2, 0          ; t2 = 0 сумматор

; метка sum_loop: (адрес 0x00000018)
0x00000018 - 01030663 - beq t1, zero, +20       ; если t1 == 0, прыжок на end_loop (адрес 0x2C)
0x0000001C - 0002AEE3 - lw t3, 0(t0)            ; чтение из памяти данных (t3 = M[t0]), отработает КЭШ!
0x00000020 - 01C383B3 - add t2, t2, t3          ; t2 = t2 + t3
0x00000024 - 00428293 - addi t0, t0, 4          ; t0 = t0 + 4 сдвиг указателя массива
0x00000028 - FFF30313 - addi t1, t1, -1         ; t1 = t1 - 1
0x0000002C - FEDFF06F - jal zero, -20           ; j sum_loop безусловный прыжок назад на 0x18

; метка end_loop: (адрес 0x00000030)
0x00000030 - 000002B7 - lui t0, 0x0             ; подготовка адреса 0x28
0x00000034 - 02828293 - addi t0, t0, 40         ; t0 = 40 0x28 - адрес переменной result
0x00000038 - 0072A023 - sw t2, 0(t0)            ; сохранение результата t2 в память данных по адресу t0
0x0000003C - 00000073 - halt                    ; остановка